#!/opt/venv/bin/python
import fcntl
import io
import os
import shutil
import subprocess
import sys
import time

import pyrosimple

INCOMPLETE = "/downloads/incomplete"
DST = "/downloads/complete"
STAGING = DST + "/.staging"
LOCK = "/rtorrent/data/rtmove.lock"
RSYNC_TIMEOUT = 600
LOG_FIFO = os.environ.get("RTMOVE_LOG_FIFO", "/tmp/log.fifo")
POSTPROCESS = os.environ.get("RTMOVE_POSTPROCESS", "/rtorrent/bin/rtpostprocess")
POSTPROCESS_TIMEOUT = int(os.environ.get("RTMOVE_POSTPROCESS_TIMEOUT", "300"))
_ESCAPE = {c: f"\\x{c:02x}" for c in (*range(0x20), 0x7f)}


class FifoStdout(io.TextIOBase):
    def __init__(self, path=LOG_FIFO):
        self.path, self._buf, self.subsystem = path, "", "rtmove"

    def write(self, s):
        *lines, self._buf = (self._buf + s).split("\n")
        for line in lines:
            try:
                prefix = f"{int(time.time())} I {self.subsystem}: "
                data = (prefix + line.translate(_ESCAPE) + "\n").encode("utf-8", "replace")
                fd = os.open(self.path, os.O_WRONLY | os.O_NONBLOCK | os.O_CLOEXEC)
                try:
                    os.write(fd, data)
                finally:
                    os.close(fd)
            except OSError:
                pass
        return len(s)

sys.stdout = FifoStdout()


def log(message, subsystem="rtmove"):
    prev, sys.stdout.subsystem = sys.stdout.subsystem, subsystem
    try:
        print(message)
    finally:
        sys.stdout.subsystem = prev


class MoveError(Exception):
    pass


def within(parent, child):
    try:
        child = os.path.realpath(child)
        parent = os.path.realpath(parent)
        return child != parent and os.path.commonpath([child, parent]) == parent
    except ValueError:
        return False


def same_fs(a, b):
    try:
        return os.stat(a).st_dev == os.stat(b).st_dev
    except OSError:
        return False


def query(proxy, state):
    return proxy.d.multicall.filtered(
        "", "main",
        "equal=d.custom=move_state,cat=" + state,
        "d.hash=", "d.custom=tm_completed",
    )


def sweep(proxy):
    for infohash, base, state in proxy.d.multicall.filtered(
        "", "main", "equal=d.wanted_chunks=,value=0",
        "d.hash=", "d.base_path=", "d.custom=move_state",
    ):
        if state or not within(INCOMPLETE, base.rstrip("/")):
            continue
        requeue(proxy, infohash, "swept")


def finalize(proxy, infohash):
    try:
        proxy.d.start(infohash)
        proxy.d.custom.set(infohash, "move_state", "")
        proxy.d.custom.set(infohash, "move_dest", "")
        proxy.d.save_resume(infohash)
    except Exception as e:
        raise MoveError(f"restart failed: {e}") from e


def park(proxy, infohash, reason=""):
    try:
        proxy.d.custom.set(infohash, "move_state", "error")
        proxy.d.save_resume(infohash)
    except Exception as e:
        print(f"park failed {infohash}: {e}")
        return
    print(f"parked {infohash}: {reason}" if reason else f"parked {infohash}")


def requeue(proxy, infohash, reason=""):
    try:
        proxy.d.custom.set(infohash, "move_state", "queued")
        proxy.d.save_resume(infohash)
    except Exception as e:
        print(f"requeue failed {infohash}: {e}")
        return
    print(f"queued {infohash}: {reason}" if reason else f"queued {infohash}")


def delete_source(path):
    if not within(INCOMPLETE, path) or not os.path.exists(path):
        return
    if os.path.isdir(path) and not os.path.islink(path):
        shutil.rmtree(path)
    else:
        os.remove(path)


def sweep_staging(active):
    try:
        entries = os.listdir(STAGING)
    except FileNotFoundError:
        return
    except OSError as e:
        print(f"staging sweep failed: {e}")
        return
    for name in entries:
        if name in active:
            continue
        path = os.path.join(STAGING, name)
        if within(DST, path):
            shutil.rmtree(path, ignore_errors=True)


def post_process(infohash, final):
    if not POSTPROCESS or not os.path.exists(POSTPROCESS):
        return
    if not os.access(POSTPROCESS, os.X_OK):
        log(f"not executable: {POSTPROCESS}", "postprocess")
        return
    try:
        result = subprocess.run(
            [POSTPROCESS, infohash, final],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=POSTPROCESS_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        log(f"timed out after {POSTPROCESS_TIMEOUT}s {infohash}", "postprocess")
        return
    except Exception as e:
        log(f"failed {infohash}: {e}", "postprocess")
        return
    for line in result.stdout.splitlines():
        log(f"{infohash}: {line}", "postprocess")
    if result.returncode != 0:
        log(f"exited {result.returncode} {infohash}", "postprocess")


def move_one(proxy, infohash):
    proxy.d.custom.set(infohash, "move_state", "moving")

    try:
        src = proxy.d.base_path(infohash).rstrip("/")
    except Exception as e:
        raise MoveError(f"base_path unavailable: {e}")

    if within(DST, src):
        print(f"already at destination {os.path.basename(src)} [{infohash}]")
        finalize(proxy, infohash)
        return
    if not within(INCOMPLETE, src) or not os.path.exists(src):
        raise MoveError("source missing")

    name = os.path.basename(src)
    stage_dir = os.path.join(STAGING, infohash)
    final = os.path.join(DST, name)

    try:
        claimed = proxy.d.custom(infohash, "move_dest")
    except Exception:
        claimed = ""

    resuming = claimed == final and os.path.lexists(final)
    if os.path.lexists(final) and not resuming:
        raise MoveError("destination exists")

    local_move = same_fs(src, DST)
    staged = os.path.join(stage_dir, name)

    try:
        if resuming:
            print(f"resuming {name} [{infohash}]")
        elif local_move:
            print(f"moving {name} [{infohash}]")
        else:
            print(f"copying {name} [{infohash}]")
            os.makedirs(stage_dir, exist_ok=True)

            rsync = [
                "rsync",
                "-a",
                f"--timeout={RSYNC_TIMEOUT}",
                "--",
                src,
                stage_dir + "/",
            ]

            if subprocess.run(rsync).returncode != 0:
                raise MoveError("rsync failed")

        try:
            proxy.d.stop(infohash)
            proxy.d.custom.set(infohash, "move_dest", final)
            proxy.d.save_resume(infohash)
        except Exception as e:
            raise MoveError(f"stop failed: {e}") from e

        if not resuming:
            if local_move:
                os.rename(src, final)
            else:
                os.rename(staged, final)

    finally:
        shutil.rmtree(stage_dir, ignore_errors=True)

    try:
        proxy.d.close(infohash)
        proxy.d.directory.set(infohash, DST)
        proxy.d.open(infohash)

        base = proxy.d.base_path(infohash).rstrip("/")
    except Exception as e:
        raise MoveError(f"repoint failed: {e}") from e

    if not within(DST, base):
        raise MoveError("repoint mismatch")

    finalize(proxy, infohash)

    print(f"moved {name} [{infohash}]")
    post_process(infohash, final)

    try:
        delete_source(src)
    except Exception as e:
        print(f"source cleanup failed {infohash}: {e}")


def main():
    if sys.argv[1:2] == ["--unpark"]:
        proxy = pyrosimple.connect().open()
        for infohash in sys.argv[2:]:
            requeue(proxy, infohash, "unparked")
        return

    try:
        lock = open(LOCK, "w")
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError as e:
        print(f"cannot acquire lock {LOCK}: {e}")
        return

    proxy = pyrosimple.connect().open()

    try:
        for infohash, _ in query(proxy, "moving"):
            requeue(proxy, infohash, "recovered")
        sweep(proxy)
    except Exception as e:
        print(f"recovery/sweep failed: {e}")

    seen = set()
    first = True
    while True:
        try:
            rows = query(proxy, "queued")
        except Exception as e:
            print(f"queue query failed: {e}")
            break
        if first:
            sweep_staging({row[0] for row in rows})
            first = False
        batch = [row for row in rows if row[0] not in seen]
        if not batch:
            break
        batch.sort(key=lambda row: int(row[1]) if (row[1] or "").isdigit() else 0)
        for infohash, _ in batch:
            seen.add(infohash)
            try:
                move_one(proxy, infohash)
            except MoveError as e:
                park(proxy, infohash, str(e))
            except Exception as e:
                park(proxy, infohash, f"unexpected: {e}")

    fcntl.flock(lock, fcntl.LOCK_UN)


if __name__ == "__main__":
    main()
