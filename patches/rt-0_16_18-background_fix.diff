+
+void
+ExecFile::reap_background_processes() noexcept {
+  auto itr = m_background_processes.begin();
+
+  while (itr != m_background_processes.end()) {
+    int   status{};
+    pid_t waited_pid;
+
+    do {
+      waited_pid = ::waitpid(*itr, &status, WNOHANG);
+    } while (waited_pid == -1 && errno == EINTR);
