    },
    {
      "name": "zlib",
      "repo": "madler/zlib",
      "type": "release",
      "pattern": "^v\\d+\\.\\d+(\\.\\d+)?$",
      "stripPattern": "^v",
      "assetPattern": "^zlib-\\d+\\.\\d+(\\.\\d+)?\\.tar\\.gz$"
    }
